{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".prettierrc*", ".prettierignore", "tsconfig*.json"],
  "tasks": {
    "audit": {
      "cache": false
    },
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "clean:dist": {
      "cache": false
    },
    "clean:test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["@yarapa/eslint-config-yarapa-imprement-demo#build", "build"]
    },
    "lint:check": {
      "dependsOn": ["@yarapa/eslint-config-yarapa-imprement-demo#build", "build"]
    },
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {}
  }
}
