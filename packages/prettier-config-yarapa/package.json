{
  "name": "@yarapa/prettier-config-yarapa-imprement-demo",
  "version": "0.0.0",
  "description": "Deterministic Prettier configuration for Yarapa projects.",
  "keywords": [
    "formatting",
    "prettier",
    "prettier-config"
  ],
  "homepage": "https://github.com/useyarapa/yarapa-code-standards/tree/main/packages/prettier-config-yarapa",
  "bugs": {
    "url": "https://github.com/useyarapa/yarapa-code-standards/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useyarapa/yarapa-code-standards.git",
    "directory": "packages/prettier-config-yarapa"
  },
  "license": "MIT",
  "author": "Yarapa",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "audit": "pnpm audit",
    "build": "tsdown",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "clean:dist": "rimraf dist",
    "clean:test": "rimraf coverage",
    "dev": "tsdown --watch",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "lint": "eslint . --fix --cache --max-warnings=0",
    "lint:check": "eslint . --cache --max-warnings=0",
    "sort-package-json": "sort-package-json package.json",
    "sort-package-json:check": "sort-package-json --check package.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "prettier-plugin-sh": "0.20.2"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "prettier": ">=3.6.0 <4.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
